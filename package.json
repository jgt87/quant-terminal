{
  "name": "quant-terminal",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/jgt87/quant-terminal.git"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "workspaces": [
    "core",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web \"npm run dev -w server\" \"npm run dev -w web\"",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "test": "vitest run",
    "typecheck": "tsc -p core && tsc -p server --noEmit && tsc -p web --noEmit",
    "build": "npm run build -w web",
    "start": "npm run start -w server",
    "test:drawings": "node tools/test-drawings.mjs"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vitest": "5.1.0",
    "concurrently": "9.1.0",
    "@types/node": "22.20.5",
    "vite": "8.3.6"
  }
}
